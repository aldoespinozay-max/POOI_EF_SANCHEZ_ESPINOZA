@model POOI_EF_Sanchez_Espinoza.Models.Consumidor
@{
    ViewBag.Title = "actualizar consumidor";
}

<h2>actualizar consumidor</h2>
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.DniCont)
    <p>dni: @Model.DniCont</p>
    <div class="form-group">
        @Html.LabelFor(model => model.NomCont, "nombre")
        @Html.EditorFor(model => model.NomCont, new { htmlAttributes = new { @class = "form-control" } })
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.ApeCont, "apellido")
        @Html.EditorFor(model => model.ApeCont, new { htmlAttributes = new { @class = "form-control" } })
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.EmailCont, "correo")
        @Html.EditorFor(model => model.EmailCont, new { htmlAttributes = new { @class = "form-control" } })
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.IdPais, "código de país")
        @Html.EditorFor(model => model.IdPais, new { htmlAttributes = new { @class = "form-control", maxlength = "3" } })
    </div>
    <p>@ViewBag.Mensaje</p>
    <input type="submit" value="actualizar" class="btn btn-primary" />
}
<p>@Html.ActionLink("volver a la lista", "Index")</p>
